<%- include('../partials/app-start', { title: 'Categories', active: 'categories' }) %>
<div class="row g-3">
  <div class="col-12 col-lg-8">
    <div class="glass p-4">
      <h2 class="h5 fw-bold mb-3">Your categories</h2>
      <% if (categories.length === 0) { %>
        <p class="text-muted-2 mb-0">You have no categories yet. Add one to get started.</p>
      <% } %>
      <ul class="list-unstyled mb-0">
        <% categories.forEach((c) => { %>
          <li class="list-row">
            <span class="flex-grow-1 fw-medium"><%= c.name %></span>
            <span class="pill pill-soft"><%= c.tx_count %> <%= c.tx_count === 1 ? 'transaction' : 'transactions' %></span>
            <a class="icon-btn" href="/categories/<%= c.id %>/edit" title="Edit <%= c.name %>">
              <i class="bi bi-pencil"></i><span class="visually-hidden">Edit <%= c.name %></span>
            </a>
            <% if (c.tx_count > 0) { %>
              <span class="icon-btn disabled" title="Cannot delete: this category has transactions">
                <i class="bi bi-trash"></i><span class="visually-hidden">Cannot delete <%= c.name %></span>
              </span>
            <% } else { %>
              <button type="button" class="icon-btn" data-bs-toggle="modal" data-bs-target="#deleteModal"
                      data-name="<%= c.name %>" data-action="/categories/<%= c.id %>/delete" title="Delete <%= c.name %>">
                <i class="bi bi-trash"></i><span class="visually-hidden">Delete <%= c.name %></span>
              </button>
            <% } %>
          </li>
        <% }) %>
      </ul>
      <p class="text-muted-2 small mt-3 mb-0">A category that has transactions cannot be deleted.</p>
    </div>
  </div>

  <div class="col-12 col-lg-4">
    <div class="glass p-4">
      <h2 class="h5 fw-bold mb-3">Add category</h2>
      <form method="POST" action="/categories" novalidate>
        <div class="mb-3">
          <label for="name" class="form-label">Name</label>
          <input type="text" id="name" name="name" maxlength="60" class="form-control <%= errors.name ? 'is-invalid' : '' %>" value="<%= values.name || '' %>">
          <% if (errors.name) { %><div class="invalid-feedback"><%= errors.name.msg %></div><% } %>
        </div>
        <button type="submit" class="btn btn-pill">Save</button>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body p-4">
        <h2 class="h5 fw-bold" id="deleteModalLabel">Delete category?</h2>
        <p class="mb-4">Delete <strong id="deleteName"></strong>? Any budget set for it will be removed too.</p>
        <form method="POST" id="deleteForm" class="d-flex gap-2">
          <button type="submit" class="btn btn-pill">Delete</button>
          <button type="button" class="btn btn-pill-soft" data-bs-dismiss="modal">Cancel</button>
        </form>
      </div>
    </div>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var modal = document.getElementById('deleteModal');
    modal.addEventListener('show.bs.modal', function (event) {
      var button = event.relatedTarget;
      document.getElementById('deleteName').textContent = button.getAttribute('data-name');
      document.getElementById('deleteForm').setAttribute('action', button.getAttribute('data-action'));
    });
  });
</script>
<%- include('../partials/app-end') %>