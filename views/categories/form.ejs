<%- include('../partials/app-start', { title: 'Edit category', active: 'categories' }) %>
<div class="row">
  <div class="col-12 col-md-8 col-lg-5">
    <div class="glass p-4">
      <h2 class="h5 fw-bold mb-3">Rename category</h2>
      <form method="POST" action="/categories/<%= category.id %>" novalidate>
        <div class="mb-3">
          <label for="name" class="form-label">Name</label>
          <input type="text" id="name" name="name" maxlength="60" class="form-control <%= errors.name ? 'is-invalid' : '' %>" value="<%= values.name || '' %>">
          <% if (errors.name) { %><div class="invalid-feedback"><%= errors.name.msg %></div><% } %>
        </div>
        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-pill">Save</button>
          <a href="/categories" class="btn btn-pill-soft">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>
<%- include('../partials/app-end') %>