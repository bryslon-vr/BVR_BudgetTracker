<%- include('partials/head', { title: 'Welcome' }) %>
<main class="app-shell d-flex align-items-center justify-content-center">
  <div class="glass p-4 p-md-5 auth-card text-center">
    <h1 class="h2 fw-bold mb-2">Budget Tracker</h1>
    <p class="text-muted-2 mb-4">See where your money goes each month and whether you are staying within budget.</p>
    <%- include('partials/flash') %>
    <% if (currentUser) { %>
      <a href="/dashboard" class="btn btn-pill">Go to dashboard</a>
    <% } else { %>
      <a href="/login" class="btn btn-pill me-2">Log in</a>
      <a href="/register" class="btn btn-pill-soft">Register</a>
    <% } %>
  </div>
</main>
<%- include('partials/foot') %>