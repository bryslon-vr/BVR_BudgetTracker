<%- include('partials/head', { title: 'Dashboard' }) %>
<main class="app-shell">
  <div class="glass p-4 p-md-5">
    <%- include('partials/flash') %>
    <h1 class="h3 fw-bold">Welcome, <%= currentUser.name %></h1>
    <p class="text-muted-2">You are logged in as <span class="pill pill-blue"><%= currentUser.role %></span></p>
    <p>The real dashboard comes in Week 3.</p>
    <form method="POST" action="/logout">
      <button type="submit" class="btn btn-pill">Log out</button>
    </form>
  </div>
</main>
<%- include('partials/foot') %>