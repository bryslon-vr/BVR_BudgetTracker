<%- include('../partials/app-start', { title: 'Transactions', active: 'transactions' }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <span class="text-muted-2">Your latest 50 transactions</span>
  <a href="/transactions/new" class="btn btn-pill">Add transaction</a>
</div>

<div class="glass p-4">
  <% if (transactions.length === 0) { %>
    <p class="mb-0 text-muted-2">No transactions yet. Add your first one.</p>
  <% } %>
  <ul class="list-unstyled mb-0">
    <% transactions.forEach((t) => { %>
      <li class="list-row">
        <div class="flex-grow-1">
          <div class="fw-medium"><%= t.note || t.category %></div>
          <div class="small text-muted-2"><%= fmtDate(t.date) %></div>
        </div>
        <span class="pill pill-soft"><%= t.category %></span>
        <strong class="amount <%= t.type === 'income' ? 'amount-in' : '' %>"><%= t.type === 'income' ? '+' : '-' %><%= money(t.amount) %></strong>
      </li>
    <% }) %>
    </ul>
  </div>
<%- include('../partials/app-end') %>