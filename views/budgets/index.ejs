<%- include('../partials/app-start', { title: 'Budgets', active: 'budgets' }) %>
<%
  const signed = (n) => (n < 0 ? '-' + money(Math.abs(n)) : money(n));
  const statusInfo = {
    ok: ['pill-soft', 'On track'],
    warning: ['pill-warn', 'Almost at limit'],
    exceeded: ['pill-over', 'Over budget'],
  };
%>
<div class="d-flex align-items-center gap-2 mb-3">
  <a class="icon-btn" href="/budgets?month=<%= prevMonth %>" title="Previous month">
    <i class="bi bi-chevron-left"></i><span class="visually-hidden">Previous month</span>
  </a>
  <h2 class="h5 fw-bold mb-0"><%= monthLabel %></h2>
  <a class="icon-btn" href="/budgets?month=<%= nextMonth %>" title="Next month">
    <i class="bi bi-chevron-right"></i><span class="visually-hidden">Next month</span>
  </a>
</div>

<div class="row g-3">
  <div class="col-12 col-lg-8">
    <div class="row g-3 mb-3">
      <div class="col-12 col-sm-4"><div class="glass p-3 h-100"><div class="small text-muted-2">Budgeted</div><div class="fw-bold"><%= money(totals.limit) %></div></div></div>
      <div class="col-12 col-sm-4"><div class="glass p-3 h-100"><div class="small text-muted-2">Spent</div><div class="fw-bold"><%= money(totals.spent) %></div></div></div>
      <div class="col-12 col-sm-4"><div class="glass p-3 h-100"><div class="small text-muted-2">Remaining</div><div class="fw-bold"><%= signed(totals.remaining) %></div></div></div>
    </div>

    <div class="glass p-4 mb-3">
      <h2 class="h5 fw-bold mb-3">Budgets for <%= monthLabel %></h2>
      <% if (budgeted.length === 0) { %>
        <p class="mb-0 text-muted-2">No budgets set for this month yet. Use the form to add one.</p>
      <% } %>
      <ul class="list-unstyled mb-0">
        <% budgeted.forEach((b) => { %>
          <li class="list-row">
            <div class="flex-grow-1 min-w-0">
              <div class="d-flex justify-content-between gap-2">
                  <span class="d-flex align-items-center gap-2 min-w-0">
                  <span class="fw-medium text-truncate"><%= b.name %></span>
                  <span class="pill <%= statusInfo[b.status][0] %>"><%= statusInfo[b.status][1] %></span>
                  </span>
                <span class="small text-muted-2 text-nowrap"><%= money(b.spent) %> of <%= money(b.amount_limit) %></span>
              </div>
              <div class="progress mt-2" role="progressbar" aria-label="<%= b.name %> budget used"
                   aria-valuenow="<%= b.percent %>" aria-valuemin="0" aria-valuemax="100">
              <div class="progress-bar <%= b.status === 'warning' ? 'warn' : '' %><%= b.status === 'exceeded' ? 'over' : '' %>" style="width: <%= b.barWidth %>%"></div>
              </div>
              <div class="small text-muted-2 mt-1">
                <%= b.percent %>% used &middot; <%= b.remaining >= 0 ? money(b.remaining) + ' left' : 'Over by ' + money(Math.abs(b.remaining)) %>
              </div>
            </div>
            <a class="icon-btn" href="/budgets?month=<%= month %>&amp;edit=<%= b.category_id %>" title="Change limit">
              <i class="bi bi-pencil"></i><span class="visually-hidden">Change the <%= b.name %> limit</span>
            </a>
            <button type="button" class="icon-btn" data-bs-toggle="modal" data-bs-target="#deleteModal"
                    data-label="<%= b.name %> budget (<%= monthLabel %>)" data-action="/budgets/<%= b.budget_id %>/delete" title="Remove budget">
              <i class="bi bi-trash"></i><span class="visually-hidden">Remove the <%= b.name %> budget</span>
            </button>
          </li>
        <% }) %>
      </ul>
    </div>

    <% if (unbudgeted.length > 0) { %>
      <div class="glass p-4">
        <h2 class="h6 fw-bold mb-3">Categories without a budget</h2>
        <div class="d-flex flex-wrap gap-2">
          <% unbudgeted.forEach((c) => { %>
            <a class="pill pill-soft text-decoration-none" href="/budgets?month=<%= month %>&amp;edit=<%= c.category_id %>">+ <%= c.name %></a>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>

  <div class="col-12 col-lg-4">
    <div class="glass p-4">
      <h2 class="h5 fw-bold mb-1"><%= editing ? 'Change a budget' : 'Set a budget' %></h2>
      <p class="small text-muted-2 mb-3">For <%= monthLabel %></p>
      <% if (categories.length === 0) { %>
        <p class="mb-3">You need a category first.</p>
        <a href="/categories" class="btn btn-pill">Add a category</a>
      <% } else { %>
        <form method="POST" action="/budgets" novalidate>
          <input type="hidden" name="month" value="<%= month %>">
          <% if (errors.month) { %><div class="alert alert-danger rounded-4"><%= errors.month.msg %></div><% } %>
          <div class="mb-3">
            <label for="category_id" class="form-label">Category</label>
            <select id="category_id" name="category_id" class="form-select form-control <%= errors.category_id ? 'is-invalid' : '' %>">
              <option value="">Choose a category</option>
              <% categories.forEach((c) => { %>
                <option value="<%= c.category_id %>" <%= String(values.category_id) === String(c.category_id) ? 'selected' : '' %>><%= c.name %></option>
              <% }) %>
            </select>
            <% if (errors.category_id) { %><div class="invalid-feedback"><%= errors.category_id.msg %></div><% } %>
          </div>
          <div class="mb-3">
            <label for="amount_limit" class="form-label">Monthly limit (R)</label>
            <input type="text" inputmode="decimal" id="amount_limit" name="amount_limit" placeholder="0.00"
                   class="form-control <%= errors.amount_limit ? 'is-invalid' : '' %>" value="<%= values.amount_limit || '' %>">
            <% if (errors.amount_limit) { %><div class="invalid-feedback"><%= errors.amount_limit.msg %></div><% } %>
          </div>
          <button type="submit" class="btn btn-pill">Save budget</button>
        </form>
        <p class="small text-muted-2 mt-3 mb-0">Saving a category that already has a budget this month changes its limit.</p>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/delete-modal', { modalTitle: 'Remove budget?', modalNote: 'Your transactions are not affected.' }) %>
<%- include('../partials/app-end') %>