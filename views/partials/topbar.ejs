<header class="topbar">
  <div>
    <h1 class="h4 fw-bold mb-0"><%= typeof title !== 'undefined' ? title : '' %></h1>
    <small class="text-muted-2">Hello, <%= currentUser.name.split(' ')[0] %></small>
  </div>
  <div class="d-flex align-items-center gap-2">
    <span class="pill pill-blue"><%= currentUser.role %></span>
    <span class="avatar" aria-hidden="true"><%= currentUser.name.charAt(0).toUpperCase() %></span>
  </div>
</header>