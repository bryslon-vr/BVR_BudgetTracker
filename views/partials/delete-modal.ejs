<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body p-4">
        <h2 class="h5 fw-bold" id="deleteModalLabel"><%= modalTitle %></h2>
        <p class="mb-4">Delete <strong id="deleteLabel"></strong>? <%= modalNote %></p>
        <form method="POST" id="deleteForm" class="d-flex gap-2">
          <button type="submit" class="btn btn-pill">Delete</button>
          <button type="button" class="btn btn-pill-soft" data-bs-dismiss="modal">Cancel</button>
        </form>
      </div>
    </div>
  </div>
</div>