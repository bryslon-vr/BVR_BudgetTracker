<%
  const current = typeof active !== 'undefined' ? active : '';
  // Remove "soon: true" from an item when you have built its page
  const items = currentUser.role === 'admin'
    ? [
        { key: 'admin', label: 'Statistics', href: '/admin', icon: 'bar-chart-line' },
      ]
    : [
        { key: 'dashboard', label: 'Dashboard', href: '/dashboard', icon: 'grid-1x2' },
        { key: 'transactions', label: 'Transactions', href: '/transactions', icon: 'arrow-left-right', soon: true },
        { key: 'categories', label: 'Categories', href: '/categories', icon: 'tags', soon: true },
        { key: 'budgets', label: 'Budgets', href: '/budgets', icon: 'piggy-bank', soon: true },
      ];
  const home = currentUser.role === 'admin' ? '/admin' : '/dashboard';
%>
<nav class="sidebar glass" aria-label="Main navigation">
  <a class="sidebar-brand" href="<%= home %>" aria-label="Budget Tracker home"><i class="bi bi-wallet2"></i></a>
  <ul class="sidebar-nav list-unstyled">
    <% items.forEach((item) => { %>
      <li>
        <% if (item.soon) { %>
          <span class="nav-link disabled" title="<%= item.label %> (coming soon)" aria-disabled="true">
            <i class="bi bi-<%= item.icon %>"></i><span class="visually-hidden"><%= item.label %></span>
          </span>
        <% } else { %>
          <a class="nav-link <%= current === item.key ? 'active' : '' %>" href="<%= item.href %>" title="<%= item.label %>" <%- current === item.key ? 'aria-current="page"' : '' %>>
            <i class="bi bi-<%= item.icon %>"></i><span class="visually-hidden"><%= item.label %></span>
          </a>
        <% } %>
      </li>
    <% }) %>
  </ul>
  <form method="POST" action="/logout" class="sidebar-bottom">
    <button type="submit" class="nav-link" title="Log out"><i class="bi bi-box-arrow-right"></i><span class="visually-hidden">Log out</span></button>
  </form>
</nav>